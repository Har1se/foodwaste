        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"listing_id\": {{listing_id}},\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": "http://localhost:8000/orders"
      },
      "event": [
