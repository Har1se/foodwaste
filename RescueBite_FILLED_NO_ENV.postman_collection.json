    {
      "name": "11 Register Vendor Profile",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{vendor_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"business_name\": \"Green Cafe\",\n  \"bin_number\": \"123456789012\",\n  \"address\": \"Almaty, Abaya 1\",\n  \"latitude\": 43.238,\n  \"longitude\": 76.945\n}"
        },
        "url": "http://localhost:8000/vendors/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created or 409 Already exists', () => pm.expect([201, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) pm.collectionVariables.set('vendor_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Get My Vendor Profile - saves vendor_id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{vendor_token}}" }],
        "url": "http://localhost:8000/vendors/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('vendor_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Approve Vendor",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"approve\",\n  \"reason\": \"Documents verified\"\n}"
        },
        "url": "http://localhost:8000/admin/vendors/{{vendor_id}}/approve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Create Listing",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{vendor_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sushi Box\",\n  \"description\": \"Fresh sushi set\",\n  \"original_price\": 5000,\n  \"discount_percentage\": 40,\n  \"quantity_total\": 10,\n  \"pickup_window_start\": \"2026-12-31T18:00:00\",\n  \"pickup_window_end\": \"2026-12-31T21:00:00\",\n  \"allergens\": [\"fish\", \"gluten\"],\n  \"latitude\": 43.238,\n  \"longitude\": 76.945,\n  \"photo_url\": null\n}"
        },
        "url": "http://localhost:8000/listings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('listing_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Browse Listings",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/listings?limit=20"
      }
    },
    {
      "name": "16 Get Listing By ID",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/listings/{{listing_id}}"
      }
    },
    {
      "name": "17 Allergen Check",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customer_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ingredients\": [\"wheat flour\", \"salmon\", \"rice\"],\n  \"user_allergens\": [\"gluten\", \"dairy\"]\n}"
        },
        "url": "http://localhost:8000/listings/allergen-check"
      }
    },
    {
      "name": "18 Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
