{
  "info": {
    "name": "RescueBite FILLED NO ENV",
    "description": "Готовая заполненная коллекция без Postman Environment. URL уже прописаны как http://localhost:8000. OTP-код все равно нужно вставлять вручную, потому что он генерируется backend-ом при регистрации.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "customer_token", "value": "", "type": "string" },
    { "key": "vendor_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "customer_refresh", "value": "", "type": "string" },
    { "key": "vendor_refresh", "value": "", "type": "string" },
    { "key": "admin_refresh", "value": "", "type": "string" },
    { "key": "vendor_id", "value": "1", "type": "string" },
    { "key": "listing_id", "value": "1", "type": "string" },
    { "key": "order_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Customer Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@test.kz\",\n  \"password\": \"Secure123!\",\n  \"role\": \"customer\",\n  \"full_name\": \"Test Customer\"\n}"
        },
        "url": "http://localhost:8000/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created or 409 Already exists', () => pm.expect([201, 409, 429]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Customer Verify Email - paste OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@test.kz\",\n  \"code\": \"PASTE_CUSTOMER_OTP_HERE\"\n}"
        },
        "url": "http://localhost:8000/auth/verify-email",
        "description": "Замени PASTE_CUSTOMER_OTP_HERE на реальный OTP из email или из таблицы otp_codes."
      }
    },
    {
      "name": "04 Customer Login - saves token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@test.kz\",\n  \"password\": \"Secure123!\"\n}"
        },
        "url": "http://localhost:8000/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('customer_token', json.access_token);",
              "pm.collectionVariables.set('customer_refresh', json.refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Vendor Register User",
