    {
      "name": "06 — Orders",
      "item": [
        {
          "name": "POST /orders — Create Order (∞ раз)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"listing_id\": {{listing_id}}, \"quantity\": 1 }\n  ]\n}" },
            "url": "{{base_url}}/orders",
            "description": "Pre-request script сбрасывает сток до 9999 перед каждым запросом → всегда 201"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Сбрасываем сток до 9999 перед каждым заказом",
                "const adminToken = pm.collectionVariables.get('admin_token');",
                "const listingId  = pm.collectionVariables.get('listing_id');",
                "const baseUrl    = pm.collectionVariables.get('base_url');",
                "if (adminToken && listingId && baseUrl) {",
                "    pm.sendRequest({",
                "        url: baseUrl + '/admin/listings/' + listingId,",
                "        method: 'PATCH',",
                "        header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + adminToken },",
                "        body: { mode: 'raw', raw: JSON.stringify({ quantity_total: 9999, status: 'active' }) }",
                "    }, (err, res) => {",
                "        if (err) console.log('Stock reset failed:', err);",
                "        else console.log('Stock reset OK, status:', res.code);",
                "    });",
                "}"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) {",
                "  const j = pm.response.json();",
                "  pm.collectionVariables.set('order_id', j.id);",
                "  pm.test('has pickup_token', () => pm.expect(j.pickup_token).to.be.a('string'));",
                "}"
              ]}
            }
          ]
        },
        {
          "name": "GET /orders — My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
