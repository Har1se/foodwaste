{
  "info": {
    "name": "RescueBite API READY",
    "description": "Готовая коллекция для проверки RescueBite API. Сначала запускай Health, затем Auth -> Register/Verify/Login для customer, vendor, admin. OTP-код нужно взять из email и вручную вставить в Verify Email.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "password", "value": "Secure123!", "type": "string" },
    { "key": "customer_email", "value": "customer@test.kz", "type": "string" },
    { "key": "vendor_email", "value": "vendor@test.kz", "type": "string" },
    { "key": "admin_email", "value": "admin@test.kz", "type": "string" },
    { "key": "customer_token", "value": "", "type": "string" },
    { "key": "vendor_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "customer_refresh", "value": "", "type": "string" },
    { "key": "vendor_refresh", "value": "", "type": "string" },
    { "key": "admin_refresh", "value": "", "type": "string" },
    { "key": "otp_code", "value": "PASTE_OTP_HERE", "type": "string" },
    { "key": "reset_token", "value": "PASTE_RESET_TOKEN_HERE", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" },
    { "key": "vendor_id", "value": "1", "type": "string" },
    { "key": "listing_id", "value": "1", "type": "string" },
    { "key": "order_id", "value": "1", "type": "string" },
    { "key": "task_id", "value": "PASTE_TASK_ID_HERE", "type": "string" }
  ],
  "item": [
    {
      "name": "00 System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth - Customer",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"customer\",\n  \"full_name\": \"Test Customer\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created or 409 Exists', () => pm.expect([201, 409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Verify Customer Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": "{{base_url}}/auth/verify-email",
            "description": "Перед запуском вставь OTP из письма в collection variable otp_code."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Login Customer - save tokens",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('customer_token', json.access_token);",
                  "pm.collectionVariables.set('customer_refresh', json.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/auth/me"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update Customer Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Customer\",\n  \"phone\": \"+77000000001\",\n  \"allergen_profile\": [\"gluten\", \"dairy\"]\n}"
            },
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Refresh Customer Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{customer_refresh}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('customer_token', json.access_token);",
                  "pm.collectionVariables.set('customer_refresh', json.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customer_email}}\"\n}"
            },
            "url": "{{base_url}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"NewSecure123!\"\n}"
            },
            "url": "{{base_url}}/auth/reset-password"
          }
        },
        {
          "name": "Logout Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{customer_refresh}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
