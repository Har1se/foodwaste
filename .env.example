# ════════════════════════════════════════════════════════════════════════════════
# RescueBite — Environment Variables Reference
# Copy this file to .env and fill in your values before running docker compose up
# ════════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Use service name "postgres" (not localhost) inside docker-compose
DATABASE_URL=postgresql+asyncpg://rescuebite:CHANGE_ME@postgres:5432/rescuebite_db
POSTGRES_USER=rescuebite
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rescuebite_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use service name "redis" (not localhost) inside docker-compose
REDIS_URL=redis://redis:6379/0

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_minimum_32_chars
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_minimum_32_chars

# Optional: separate secret for refresh tokens (falls back to JWT_SECRET_KEY if empty)
JWT_REFRESH_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (REQUIRED for OTP + notifications) ─────────────────────────────────
# Option A — Brevo (рекомендуется, бесплатно 300 писем/день, без 2FA)
#   1. Зарегистрируйся на brevo.com
#   2. SMTP & API → SMTP → скопируй логин и создай SMTP ключ
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=BREVO_SMTP_KEY_HERE
SMTP_FROM=your@email.com

# Option B — Gmail App Password
#   1. Enable 2FA: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=your@gmail.com

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ENABLE_RATE_LIMIT=true
DEV_AUTO_VERIFY_EMAIL=false
DEV_AUTO_APPROVE_VENDORS=false

# ── CORS (comma-separated, required for production) ───────────────────────────
CORS_ORIGINS=https://rescuebite.deployrocks.com,https://rescuebite-api.deployrocks.com

FRONTEND_URL=https://rescuebite.deployrocks.com

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Kaspi Pay ─────────────────────────────────────────────────────────────────
KASPI_API_KEY=CHANGE_ME
KASPI_MERCHANT_ID=CHANGE_ME
KASPI_WEBHOOK_SECRET=CHANGE_ME

# ── S3 Storage ────────────────────────────────────────────────────────────────
S3_BUCKET=rescuebite-media
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
