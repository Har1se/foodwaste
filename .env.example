# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rescuebite:CHANGE_ME@localhost:5433/rescuebite_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security (REQUIRED: minimum 32 chars) ─────────────────────────────────────
SECRET_KEY=CHANGE_ME_minimum_32_characters_long_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Kaspi Pay ─────────────────────────────────────────────────────────────────
KASPI_API_KEY=CHANGE_ME
KASPI_MERCHANT_ID=CHANGE_ME
KASPI_WEBHOOK_SECRET=CHANGE_ME

# ── S3 Storage ────────────────────────────────────────────────────────────────
S3_BUCKET=rescuebite-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@rescuebite.kz
FRONTEND_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]
