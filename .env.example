# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rescuebite:CHANGE_ME@localhost:5433/rescuebite_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security (REQUIRED: minimum 32 chars) ─────────────────────────────────────
SECRET_KEY=CHANGE_ME_minimum_32_characters_long_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Kaspi Pay ─────────────────────────────────────────────────────────────────
KASPI_API_KEY=CHANGE_ME
KASPI_MERCHANT_ID=CHANGE_ME
KASPI_WEBHOOK_SECRET=CHANGE_ME

# ── S3 Storage ────────────────────────────────────────────────────────────────
S3_BUCKET=rescuebite-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ── Email (SMTP / Gmail) ──────────────────────────────────────────────────────
# 1. Enable 2FA on your Google account: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
#    Choose "Other", name it "RescueBite", copy the 16-char password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=your@gmail.com
FRONTEND_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ENABLE_RATE_LIMIT=false
DEV_AUTO_VERIFY_EMAIL=true
DEV_AUTO_APPROVE_VENDORS=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://rescuebite.deployrocks.com","https://rescuebite-api.deployrocks.com"]

# ── Production overrides (set these when deploying) ───────────────────────────
# ENVIRONMENT=production
# DEBUG=false
# ENABLE_RATE_LIMIT=true
# SECRET_KEY=<strong random 64-char string>
# ALLOWED_ORIGINS=["https://rescuebite.deployrocks.com"]
# FRONTEND_URL=https://rescuebite.deployrocks.com
